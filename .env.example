# Copy to .env.local (never commit real values). See docs/llm/runbook.md
# Neon Postgres, added through the Vercel Marketplace (vercel env pull fills it)
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, the deployment URL on Vercel
BETTER_AUTH_URL=http://localhost:3000

# Password for the demo users created by `pnpm db:seed`. Put it in .env (not .env.local, which `vercel env pull` overwrites)
SEED_PASSWORD=
