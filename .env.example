# Copy to .env.local (never commit real values). See docs/llm/runbook.md
# Neon Postgres, added through the Vercel Marketplace (vercel env pull fills it)
DATABASE_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, the deployment URL on Vercel
BETTER_AUTH_URL=http://localhost:3000

# Password for the demo users created by `pnpm db:seed`. Put it in .env (not .env.local, which `vercel env pull` overwrites)
SEED_PASSWORD=

# Email (D-13). Without RESEND_API_KEY every email is simulated and only logged on the server
RESEND_API_KEY=
# Sender. Defaults to Resend's test sender "Harinas Elizondo <onboarding@resend.dev>" (no verified domain needed)
EMAIL_FROM=
# Warehouse mailbox that always receives certificates (RF-05). Defaults to almacen@demo.test
WAREHOUSE_EMAIL=
# Optional. Send every real email to this one address instead (Resend without a verified domain only delivers to the account owner)
EMAIL_REDIRECT_TO=
